#!/usr/bin/env bash
# Git credential helper: picks the token from GH_TOKENS ("owner=token ...", first = default) by repo owner.
[[ "${1:-}" == get ]] || exit 0

host="" path=""
while IFS='=' read -r key value; do
    [[ -z "$key" ]] && break
    case "$key" in
        host) host="$value" ;;
        path) path="$value" ;;
    esac
done
[[ "$host" == github.com ]] || exit 0

owner="${path%%/*}"
owner="${owner,,}"
token=""
for entry in ${GH_TOKENS:-}; do
    [[ -n "${entry#*=}" ]] || continue
    [[ -z "$token" ]] && token="${entry#*=}"
    name="${entry%%=*}"
    if [[ "${name,,}" == "$owner" ]]; then
        token="${entry#*=}"
        break
    fi
done
[[ -n "$token" ]] || exit 0

echo "username=x-access-token"
echo "password=$token"
